[Unit]
Description=Delicate Studio
After=network.target dj-app.service

[Service]
ExecStart=/opt/delicate-studio/target/release/delicate-studio
WorkingDirectory=/opt/delicate-studio
Environment=STUDIO_WEB=/opt/delicate-studio/web
Environment=STUDIO_DJ=http://127.0.0.1:4540
DynamicUser=yes
StateDirectory=delicate-studio
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
